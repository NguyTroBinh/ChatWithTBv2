# Embedding
EMBEDDING_MODEL_NAME=AITeamVN/Vietnamese_Embedding
MODEL_CACHE_DIR=models_cache
EMBEDDING_DIMENSION=1024
BATCH_SIZE=32

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j
CHUNK_VECTOR_INDEX=chunk_embedding

# Reranker
RERANKER_MODEL_NAME=AITeamVN/Vietnamese_Reranker

# LLM via LiteLLM
LLM_MODEL=nvidia_nim/openai/gpt-oss-20b
LLM_API_BASE=https://integrate.api.nvidia.com/v1
LLM_API_KEY=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=120
LLM_THINK=false             # for ollama model
LLM_REASONING_EFFORT=low    # low/medium/high
