# Embedding
EMBEDDING_MODEL_NAME=AITeamVN/Vietnamese_Embedding
MODEL_CACHE_DIR=models_cache
EMBEDDING_DIMENSION=1024
BATCH_SIZE=32

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j
CHUNK_VECTOR_INDEX=chunk_embedding

# Reranker
RERANKER_MODEL_NAME=AITeamVN/Vietnamese_Reranker

# LLM via LiteLLM
# OpenAI-compatible default. Set LLM_API_BASE for local OpenAI-compatible servers.
LLM_MODEL=z-ai/glm-5.2"
LLM_API_BASE=
LLM_API_KEY=
LLM_TEMPERATURE=1
LLM_MAX_TOKENS=4096
