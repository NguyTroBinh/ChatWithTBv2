# Embedding
EMBEDDING_MODEL_NAME=AITeamVN/Vietnamese_Embedding
MODEL_CACHE_DIR=models_cache
EMBEDDING_DIMENSION=1024
BATCH_SIZE=32

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j
CHUNK_VECTOR_INDEX=chunk_embedding

# Redis short-term memory
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_MAX_MESSAGES=50
LIMIT_MESSAGES=20

# Neo4j long-term memory
MEMORY_VECTOR_INDEX=memory_embedding
MEMORY_RECALL_LIMIT=5
MEMORY_RECALL_RELATION_LIMIT=5
MEMORY_RECALL_EXPANSION_LIMIT=10
MEMORY_RECALL_MIN_SCORE=0.0
MEMORY_DEFAULT_IMPORTANCE=0.5
MEMORY_ENRICHMENT_ENABLED=true
MEMORY_ENRICHMENT_CANDIDATE_LIMIT=5
MEMORY_ENRICHMENT_MAX_ATTEMPTS=3
MEMORY_ENRICHMENT_RETRY_BACKOFF_SECONDS=5
MEMORY_ENRICHMENT_SIMILARITY_LIMIT=5
MEMORY_ENRICHMENT_SIMILARITY_THRESHOLD=0.8

# Consolidation
MEMORY_CONSOLIDATION_ENABLED=true
CONSOLIDATION_TICK_SECONDS=60
CONSOLIDATION_DECAY_INTERVAL_SECONDS=86400
CONSOLIDATION_CREATIVE_INTERVAL_SECONDS=604800
CONSOLIDATION_CLUSTER_INTERVAL_SECONDS=2592000
CONSOLIDATION_FORGET_INTERVAL_SECONDS=0
CONSOLIDATION_DECAY_IMPORTANCE_THRESHOLD=0.3
CONSOLIDATION_HISTORY_LIMIT=20
CONSOLIDATION_BASE_DECAY_RATE=0.01
CONSOLIDATION_IMPORTANCE_FLOOR_FACTOR=0.3
CONSOLIDATION_DELETE_THRESHOLD=0.0
CONSOLIDATION_ARCHIVE_THRESHOLD=0.0
CONSOLIDATION_GRACE_PERIOD_DAYS=90
CONSOLIDATION_IMPORTANCE_PROTECTION_THRESHOLD=0.7
CONSOLIDATION_PROTECTED_TYPES=Decision,Insight
CONSOLIDATION_CREATIVE_MIN_COUNT=3
CONSOLIDATION_CLUSTER_MIN_NEIGHBORS=3
MEMORY_SEARCH_WEIGHT_VECTOR=0.35
MEMORY_SEARCH_WEIGHT_KEYWORD=0.35
MEMORY_SEARCH_WEIGHT_RELATION=0.25
MEMORY_SEARCH_WEIGHT_TAG=0.2
MEMORY_SEARCH_WEIGHT_IMPORTANCE=0.1
MEMORY_SEARCH_WEIGHT_CONFIDENCE=0.05
MEMORY_SEARCH_WEIGHT_RECENCY=0.1
MEMORY_SEARCH_WEIGHT_EXACT=0.2

# Reranker
RERANKER_MODEL_NAME=AITeamVN/Vietnamese_Reranker

# LLM via LiteLLM
LLM_MODEL=nvidia_nim/openai/gpt-oss-20b
LLM_API_BASE=https://integrate.api.nvidia.com/v1
LLM_API_KEY=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=120
LLM_THINK=false             # for ollama model
LLM_REASONING_EFFORT=low    # low/medium/high

# Context compression via Headroom TextCrusher
CONTEXT_COMPRESSION_ENABLED=false
CONTEXT_COMPRESSION_MIN_TOKENS=800
CONTEXT_COMPRESSION_TARGET_RATIO=0.65
CONTEXT_COMPRESSION_COMPRESS_HISTORY=true
CONTEXT_COMPRESSION_COMPRESS_LONG_MEMORY=true
CONTEXT_COMPRESSION_COMPRESS_CHUNKS=true
